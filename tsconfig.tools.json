//
// Build scripts, maintenance scripts and tests, which run in Node. The pure
// core they import compiles here without the WebExtension types, which keeps
// it testable without Firefox.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["es2022"],
    "types": ["node"],
    "rootDir": ".",
    "outDir": "build"
  },
  "include": ["scripts", "tests"]
}

{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "version": "1.0.0",
  "default_locale": "en",
  "icons": {
    "32": "icons/logo.svg",
    "64": "icons/logo.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{401bb0a7-67ea-41d0-97fd-09c349eec127}",

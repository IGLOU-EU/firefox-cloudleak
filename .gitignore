# Dependencies, restored from package-lock.json by npm ci.
node_modules/

# Build output: the extension as Firefox loads it, and the compiled scripts
# and tests. Both are generated from the sources at every build.
dist/
build/

# Packages produced by web-ext build, rebuilt from the sources.
web-ext-artifacts/

# Coverage reports, generated by a test run.
coverage/

# The files of a version submitted to addons.mozilla.org, written by
# npm run release.
submission/
